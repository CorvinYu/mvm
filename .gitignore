# ---------------------------------------------------------------------------
# Credentials -- never commit these.
#
# state/cookies.txt holds a logged-in bilibili session. Once pushed it cannot be
# removed by deleting the file: it stays in the git history and must be treated
# as leaked (the account session has to be invalidated).
# ---------------------------------------------------------------------------
state/cookies.txt
state/.cookie-jar/
state/browser-profile*/
config/cookies.txt
*cookies*.txt
*.cookies.txt

# ---------------------------------------------------------------------------
# Bundled runtimes -- large binaries, and not ours to redistribute here.
#   bin/     mpv + yt-dlp copies (hundreds of MB)
#   vendor/  yt-dlp source
# Install these locally instead (see README).
# ---------------------------------------------------------------------------
bin/
vendor/
*.exe
*.dll
*.pyd

# ---------------------------------------------------------------------------
# Runtime state, logs, caches
#
# These files are created while mvm runs. Several of them carry YOUR data:
#   state/align_calib.json  -- your manual alignment preferences
#   state/window.json       -- your window position
# so they must never be published even though they hold no credentials.
# ---------------------------------------------------------------------------
logs/
state/_mvm_cmd.txt
state/_mvm_status.txt
state/_mvm_now.json
state/_mvm_hotkey_offset.txt
state/_mvm_hotkey_offset.tmp
state/_mvm_manual_offset.txt
state/.follow.lock
state/.align_control.lock
state/align_calib.json
state/window.json
state/vocadb_cache/
state/_align_work/
state/_selftest_align/
state/_wiring_test/
state/_evidence/
state/_tmp/
state/delay_history.json

# ---------------------------------------------------------------------------
# Test media produced locally (regenerable with ffmpeg)
# ---------------------------------------------------------------------------
state/_*.wav
state/_*.mp4
state/_*.mp3

# ---------------------------------------------------------------------------
# Python / OS / editor
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.idea/
.vscode/
Thumbs.db
.DS_Store
NUL
